<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Sensus</AssemblyName>
    <RootNamespace>Sensus</RootNamespace>
    <Version>1.0.0</Version>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <PropertyGroup>
    <GameManaged>$(GameDir)\Lethal Company_Data\Managed</GameManaged>
    <BepInExCore>$(TestProfile)\BepInEx\core</BepInExCore>
    <LethalConfigDll Condition="'$(LethalConfigDll)' == ''">$(TestProfile)\BepInEx\plugins\AinaVT-LethalConfig\LethalConfig\LethalConfig.dll</LethalConfigDll>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../licenses/LC-Chinese-Project-MIT.txt" LogicalName="Sensus.Licenses.LC-Chinese-Project-MIT.txt" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    <Reference Include="Assembly-CSharp" HintPath="$(GameManaged)\Assembly-CSharp.dll" Publicize="true" Private="false" />
    <Reference Include="DissonanceVoip" HintPath="$(GameManaged)\DissonanceVoip.dll" Publicize="true" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameManaged)\UnityEngine.dll" Publicize="true" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManaged)\UnityEngine.CoreModule.dll" Publicize="true" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameManaged)\UnityEngine.UI.dll" Publicize="true" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(GameManaged)\UnityEngine.UIModule.dll" Publicize="true" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(GameManaged)\UnityEngine.AnimationModule.dll" Publicize="true" Private="false" />
    <Reference Include="UnityEngine.AudioModule" HintPath="$(GameManaged)\UnityEngine.AudioModule.dll" Publicize="true" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameManaged)\Unity.TextMeshPro.dll" Publicize="true" Private="false" />
    <Reference Include="Unity.Netcode.Runtime" HintPath="$(GameManaged)\Unity.Netcode.Runtime.dll" Publicize="true" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExCore)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="LethalConfig" HintPath="$(LethalConfigDll)" Private="false" />
  </ItemGroup>
  <Target Name="CheckLocalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameManaged)\Assembly-CSharp.dll')" Text="Set GameDir to your Lethal Company installation." />
    <Error Condition="!Exists('$(BepInExCore)\BepInEx.dll')" Text="Set TestProfile to a BepInEx 5 profile." />
    <Error Condition="!Exists('$(LethalConfigDll)')" Text="LethalConfig is required to compile; set LethalConfigDll. It remains optional at runtime." />
  </Target>
</Project>